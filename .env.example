# OpenOcti environment
# Copy this file to .env, then replace the six required values below.
# Never commit .env or real credentials.

# Required - replace all six values
CRM_SESSION_SECRET=replace-with-a-long-random-value
INITIAL_ADMIN_PASSWORD=replace-before-first-login
PUBLIC_APP_URL=http://localhost:3000
OPENOCTI_BUSINESS_NAME=Your business
OPENOCTI_OWNER_NAME=the owner
OWNER_EMAIL=

# OpenOcti defaults - leave unchanged
CRM_DATA_DIR=/data
DATA_BACKEND=sqlite
FCC_EDITION=openocti
NEXT_PUBLIC_FCC_EDITION=openocti

# OPENCLAW_GATEWAY_TOKEN and OPENCLAW_API_KEY:
# auto-generated on first start; set your own to override
