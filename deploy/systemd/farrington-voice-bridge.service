[Unit]
Description=Farrington Twilio Agent Voice Bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/farrington-command-center
ExecStart=/usr/bin/npm run voice:bridge
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=TWILIO_AGENT_BRIDGE_ENABLED=true
Environment=TWILIO_AGENT_BRIDGE_PORT=8788
Environment=TWILIO_AGENT_STREAM_URL=wss://crm.farringtondevelopment.com/twilio-agent-stream

[Install]
WantedBy=multi-user.target
