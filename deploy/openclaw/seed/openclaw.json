{
  "agents": {
    "defaults": {
      "workspace": "/data/openclaw/workspace/main",
      "model": { "primary": "openai/gpt-4.1", "fallbacks": [] },
      "contextPruning": { "mode": "cache-ttl", "ttl": "1h" },
      "compaction": { "mode": "safeguard" },
      "memorySearch": { "enabled": true }
    },
    "list": [
      {
