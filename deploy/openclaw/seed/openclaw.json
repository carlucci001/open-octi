      {
        "id": "matilda",
        "name": "Matilda",
        "workspace": "/data/openclaw/workspace/matilda",
        "model": { "primary": "openai/gpt-4.1", "fallbacks": [] },
        "identity": { "name": "Matilda", "emoji": "✨" },
