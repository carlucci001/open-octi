        "tools": { "alsoAllow": ["fcc_call", "fcc_search", "fcc_get_account", "fcc_create_task", "fcc_log_activity", "fcc_read_note", "fcc_write_note", "fcc_send_email", "fcc_send_signature_document", "fcc_list_tools", "fcc_open_record", "fcc_navigate_to"] }
