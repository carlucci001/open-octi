  },
  "tools": {
    "profile": "full",
    "alsoAllow": ["fcc_call", "fcc_list_tools"],
    "agentToAgent": { "allow": ["*"] }
  },
  "plugins": {
    "enabled": true,
    "allow": ["openocti"],
    "load": { "paths": ["/data/openclaw/extensions/openocti"] },
    "entries": {
      "openocti": {
        "enabled": true,
        "config": { "apiKey": "${OPENCLAW_API_KEY}" }
      }
    }
  },
  "gateway": { "auth": { "token": "${OPENCLAW_GATEWAY_TOKEN}" } }
}
