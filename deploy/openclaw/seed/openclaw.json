        "tools": { "alsoAllow": ["fcc_call", "fcc_dashboard", "fcc_search", "fcc_list_accounts", "fcc_get_account", "fcc_list_calendar_events", "fcc_create_lead", "fcc_qualify_lead", "fcc_create_task", "fcc_complete_task", "fcc_log_activity", "fcc_read_note", "fcc_write_note", "fcc_send_email", "fcc_send_signature_document", "fcc_list_tools", "fcc_open_record", "fcc_navigate_to"] }
