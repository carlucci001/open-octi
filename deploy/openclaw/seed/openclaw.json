        "tools": { "alsoAllow": ["fcc_call", "fcc_search", "fcc_create_task", "fcc_log_activity", "fcc_read_note", "fcc_write_note", "fcc_send_email", "fcc_list_tools", "fcc_open_record", "fcc_navigate_to"] }
      },
      {
        "id": "legal",
        "name": "Linda",
        "workspace": "/data/openclaw/workspace/legal",
        "model": { "primary": "openai/gpt-4.1", "fallbacks": [] },
